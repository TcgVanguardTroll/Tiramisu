{
  "settings": {
    "work_dir": "G:/tiramisu-portable",
    "log_dir":  "G:/tiramisu-portable/logs",
    "concurrency": 2
  },
  "tasks": [
    {
      "id": "auto-index",
      "description": "Re-index knowledge/ whenever files change (skips unchanged)",
      "schedule": "*/5 * * * *",
      "command": "C:/Python314/python.exe hooks/auto_index.py",
      "timeout_sec": 120,
      "retry": { "max_attempts": 2, "backoff_sec": 10 }
    },
    {
      "id": "check-candidates",
      "description": "Notify when knowledge candidates pile up; auto-dispatch Madeleine at threshold",
      "schedule": "*/30 * * * *",
      "command": "C:/Python314/python.exe hooks/check_candidates.py",
      "timeout_sec": 60,
      "retry": { "max_attempts": 1, "backoff_sec": 0 }
    },
    {
      "id": "ingest-sessions",
      "description": "Ingest new Claude Code sessions into transcripts table",
      "schedule": "*/15 * * * *",
      "command": "C:/Python314/python.exe hooks/ingest_sessions.py",
      "timeout_sec": 60,
      "retry": { "max_attempts": 1, "backoff_sec": 0 }
    },
    {
      "id": "extract-learnings",
      "description": "Extract session learnings into knowledge candidates",
      "schedule": "0 * * * *",
      "command": "C:/Python314/python.exe scripts/extract_session_learnings.py",
      "timeout_sec": 300,
      "retry": { "max_attempts": 2, "backoff_sec": 30 }
    },
    {
      "id": "github-trending",
      "description": "Fetch trending GitHub repos (full clone via Rust binary) into knowledge base (daily)",
      "schedule": "0 8 * * *",
      "command": "C:/Python314/python.exe scripts/fetch_github_trending.py",
      "timeout_sec": 300,
      "retry": { "max_attempts": 2, "backoff_sec": 60 }
    },
    {
      "id": "ingest-gentoomen",
      "description": "Convert Gentoomen Library PDFs to text for indexing (runs until complete, then skips)",
      "schedule": "0 2 * * *",
      "command": "C:/Python314/python.exe scripts/ingest_gentoomen.py",
      "timeout_sec": 3600,
      "retry": { "max_attempts": 1, "backoff_sec": 0 }
    }
  ]
}
